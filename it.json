"{col:stakeholders.name}, {col:stakeholders.title}, {col:stakeholders.organisation}. Role on the project: {col:stakeholders.kind}. Project: {col:stakeholders.project}.": "{col:stakeholders.name}, {col:stakeholders.title}, {col:stakeholders.organisation}. Ruolo sul progetto: {col:stakeholders.kind}.",
"Contact: {col:stakeholders.phone} and {col:stakeholders.email}.": "Contatto: {col:stakeholders.phone} e {col:stakeholders.email}.",
